{
  "name": "Machine",
  "namePlural": "Machines",
  "description": "A sensored machine, line, or cell in Guidewheel.",
  "icon": "gauge.with.needle",
  "parent": "account",
  "hasSearch": true,
  "fields": [
    { "key": "name", "label": "Name", "type": "string" },
    { "key": "device_id", "label": "Device ID", "type": "string" },
    { "key": "state", "label": "State", "type": "string" },
    { "key": "target", "label": "Target %", "type": "string" }
  ],
  "display": {
    "list": { "title": "{{name}}", "subtitle": "{{state}}" },
    "card": { "subtitle": ["{{device_id}}", "{{state}}"] }
  },
  "tile": {
    "type": "metric",
    "value": "{{fields.state}}",
    "label": "{{name}}",
    "icon": "gauge.with.needle"
  }
}
